# config.example.env
# ─────────────────────────────────────────────────────────────────
# Copy this file to ".env" in the same folder, then fill in your
# real values. The .env file is ignored by git — it stays local.
#
# Get your API key & secret:  https://www.spaceship.com/account/api-management/
# Get your Contact ID:        Spaceship dashboard → Contacts
# ─────────────────────────────────────────────────────────────────

SPACESHIP_API_KEY=your_api_key_here
SPACESHIP_API_SECRET=your_api_secret_here
SPACESHIP_CONTACT_ID=your_contact_id_here

# Optional — only change if you want to point at a different API environment
# SPACESHIP_BASE_URL=https://spaceship.dev/api/v1
